#!/usr/bin/env bash
# One-line installer for Claude Usage Panel:
#
#   curl -fsSL https://fschmutz.github.io/claude-usage-panel/install | bash
#   curl -fsSL https://fschmutz.github.io/claude-usage-panel/install | bash -s -- statusline mcp
#
# Clones (or fast-forwards) the repo into ~/.local/share/claude-usage-panel,
# then hands off to its ./install.sh, forwarding any arguments - so every
# install.sh target and flag (gnome, statusline, mcp, macos, --dry-run,
# --uninstall, …) works through the one-liner too. Override the checkout
# location with CLAUDE_USAGE_PANEL_HOME.
set -euo pipefail

REPO="https://github.com/fschmutz/claude-usage-panel.git"
DIR="${CLAUDE_USAGE_PANEL_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-usage-panel}"

if ! command -v git >/dev/null; then
    echo "git is required - install it first (e.g. sudo apt install git)" >&2
    exit 1
fi

if [ -d "$DIR/.git" ]; then
    echo "==> Updating existing checkout: $DIR"
    git -C "$DIR" pull --ff-only
else
    echo "==> Cloning into $DIR"
    mkdir -p "$(dirname "$DIR")"
    git clone "$REPO" "$DIR"
fi

exec "$DIR/install.sh" "$@"
